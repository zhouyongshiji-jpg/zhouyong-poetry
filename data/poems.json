    ]
  },
  {
    "id": "zy-013",
    "title": "题赠曼谷崇华中文学校",
    "subtitle": "",
    "genre": "七言律诗",
    "tune": "",
    "volume": "卷四·酬唱知交",
    "volumeId": "vol-4",
    "year": "2021",
    "location": "曼谷",
    "preface": "辛丑春参访泰华华校，见泰华少儿讽诵诗书、书声琅琅，感佩侨领师长传承华夏文脉之功。",
    "content": [
      "万里扬帆播惠风，湄滨弦诵起青聪。",
      "百年薪火传洙泗，一片丹心映碧穹。",
      "笔架山前书雅韵，砚池深处展鸿蒙。",
      "文明永续源流远，莫负韶光岁月融。"
    ],
    "notes": [
      "1. 湄滨：湄南河畔。",
      "2. 洙泗：洙水与泗水，代指孔孟儒家圣教文脉。"
    ],
    "tags": [
      "华校",
      "教育",
      "曼谷",
      "文化交流",
      "七律"
    ]
  },
