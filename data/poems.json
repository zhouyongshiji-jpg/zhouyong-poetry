[
  {
    "id": "zy-001",
    "title": "曼谷湄南河秋夕感怀",
    "subtitle": "",
    "genre": "七言律诗",
    "tune": "",
    "volume": "卷一·客海萍踪",
    "volumeId": "vol-1",
    "year": "2018",
    "location": "泰国曼谷",
    "preface": "戊戌中秋客居曼谷，登高望湄南河，月明波静，感怀故国亲朋。",
    "content": [
      "万里秋风入客舟，湄南河畔起高楼。",
      "金芒倒影摇波碧，暮色苍茫动客愁。",
      "皓月何曾分异域，清辉依旧照神州。",
      "故园松竹应无恙，举盏频呼忘白头。"
    ],
    "notes": [
      "湄南河：即昭披耶河（Chao Phraya River），贯穿曼谷市区，泰华侨界常唤湄南河。",
      "金芒：指湄南河两岸大王宫及黎明寺夜间金碧辉煌之佛塔倒影。"
    ],
    "tags": [
      "秋夕",
      "曼谷",
      "七律",
      "湄南河",
      "思乡",
      "中秋"
    ]
  },
  {
    "id": "zy-002",
    "title": "清迈素帖山观瀑偶题",
    "subtitle": "",
    "genre": "七言绝句",
    "tune": "",
    "volume": "卷一·客海萍踪",
    "volumeId": "vol-1",
    "year": "2019",
    "location": "泰国清迈",
    "preface": "己亥孟夏访兰纳古都，策杖登双龙寺后山，古木参天，幽瀑溅玉，顿觉神清气爽。",
    "content": [
      "素帖山前翠色重，穿云飞瀑玉玲珑。",
      "不知古刹梵音起，洗尽人间万缕风。"
    ],
    "notes": [
      "素帖山：清迈名山，双龙寺所在地，俯瞰全城景致。",
      "兰纳：泰国北部古代王国，清迈为其故都。"
    ],
    "tags": [
      "清迈",
      "素帖山",
      "七绝",
      "游记",
      "禅意"
    ]
  },
  {
    "id": "zy-003",
    "title": "唐人街岁暮偶感",
    "subtitle": "耀华力路迎春有作",
    "genre": "五言律诗",
    "tune": "",
    "volume": "卷一·客海萍踪",
    "volumeId": "vol-1",
    "year": "2021",
    "location": "曼谷唐人街",
    "preface": "辛丑除夕漫步耀华力路，华灯璀璨，锣鼓喧阗，同胞乡音宛在耳际，异域亦作故乡看。",
    "content": [
      "岁暮客天涯，唐街度岁华。",
      "红灯悬古肆，金字映高楣。",
      "爆竹传乡语，清樽对海花。",
      "同心连四海，无处不安家。"
    ],
    "notes": [
      "耀华力路：曼谷著名的唐人街核心商业区，春节气氛极其浓厚。",
      "海花：借指南洋繁花盛放之景。"
    ],
    "tags": [
      "春节",
      "耀华力路",
      "曼谷",
      "唐人街",
      "五律"
    ]
  },
  {
    "id": "zy-004",
    "title": "重过江南忆旧游",
    "subtitle": "",
    "genre": "七言律诗",
    "tune": "",
    "volume": "卷二·故园情愫",
    "volumeId": "vol-2",
    "year": "2016",
    "location": "江南",
    "preface": "丙申春重返故里，青石小巷，乌篷依然，感抚昔年同窗岁月。",
    "content": [
      "几度风霜鬓已秋，重来胜地忆清游。",
      "桥分流水依依绿，弄穿斜阳淡淡愁。",
      "燕子归来寻故巷，扁舟行远歇荒洲。",
      "凭栏不语斜阳外，唯见青山自在流。"
    ],
    "notes": [
      "乌篷：江南常见的水乡传统木篷小船。",
      "胜地：指青年时常聚之古镇学堂旧址。"
    ],
    "tags": [
      "江南",
      "水乡",
      "怀旧",
      "七律",
      "故园"
    ]
  },
  {
    "id": "zy-005",
    "title": "登黄鹤楼怀古",
    "subtitle": "",
    "genre": "七言律诗",
    "tune": "",
    "volume": "卷二·故园情愫",
    "volumeId": "vol-2",
    "year": "2012",
    "location": "湖北武汉",
    "preface": "壬辰秋登高怀古，楚天辽阔，大江东去，思千古兴亡。",
    "content": [
      "巍巍古阁耸江隈，极目楚天云锦开。",
      "千载白云随鹤去，一江春水逐潮来。",
      "英雄割据随流水，胜迹留连见茂苔。",
      "把酒问天凭栏立，长风万里正崔嵬。"
    ],
    "notes": [
      "江隈：大江弯曲汇流之处。",
      "随鹤去：化用崔颢《黄鹤楼》“黄鹤一去不复返，白云千载空悠悠”之典。"
    ],
    "tags": [
      "黄鹤楼",
      "长江",
      "怀古",
      "壮志",
      "七律"
    ]
  },
  {
    "id": "zy-006",
    "title": "小院春茶试新泉",
    "subtitle": "",
    "genre": "七言绝句",
    "tune": "",
    "volume": "卷三·四时清赏",
    "volumeId": "vol-3",
    "year": "2020",
    "location": "书斋",
    "preface": "庚子清明文友寄来新采明前龙井，汲泉煎沸，松风入鼎，自烹独啜，乐在其中。",
    "content": [
      "碧瓯初注雀舌香，小榻临窗竹影长。",
      "莫道闲情无处寄，半帘疏雨过回廊。"
    ],
    "notes": [
      "碧瓯：精美的青瓷或青白瓷茶盏。",
      "雀舌：上等绿茶嫩芽外形如雀舌之美称。"
    ],
    "tags": [
      "品茶",
      "春日",
      "闲适",
      "七绝",
      "茶道"
    ]
  },
  {
    "id": "zy-007",
    "title": "秋窗夜读感怀",
    "subtitle": "",
    "genre": "五言绝句",
    "tune": "",
    "volume": "卷三·四时清赏",
    "volumeId": "vol-3",
    "year": "2022",
    "location": "砚斋",
    "preface": "壬寅深秋夜阑人静，孤灯长对，偶翻旧册，忽有所悟。",
    "content": [
      "寒灯对竹简，秋籁动疏林。",
      "万古存兴废，长留一寸心。"
    ],
    "notes": [
      "秋籁：指秋风吹动林木万物所发的萧瑟声响。",
      "一寸心：指南宋陆游“此身虽老在，一寸心已死”反其意用之，喻赤子文心依旧。"
    ],
    "tags": [
      "读书",
      "秋夜",
      "五绝",
      "心境"
    ]
  },
  {
    "id": "zy-008",
    "title": "寄赠泰国文友素拉蓬先生",
    "subtitle": "兼贺八秩晋五华诞",
    "genre": "七言律诗",
    "tune": "",
    "volume": "卷四·酬唱知交",
    "volumeId": "vol-4",
    "year": "2023",
    "location": "曼谷",
    "preface": "癸卯冬，泰国潮籍华侨宿老素拉蓬（苏德生）宗长寿诞，老先生毕生弘扬中华文化，热心华教，特作律诗一首志贺。",
    "content": [
      "南邦侨彦重斯文，四海襟期四座闻。",
      "热血频倾培李桃，丹忱未改报同群。",
      "椿龄已迈期颐近，兰客齐登寿岳云。",
      "更约湄滨来岁好，举觞遥对祝殷勤。"
    ],
    "notes": [
      "南邦：指泰华侨界与南洋各邦。",
      "椿龄：庄子《逍遥游》有大椿八千岁为春，八千岁为秋，后世常借指长寿长者。",
      "期颐：百岁老人的代称。"
    ],
    "tags": [
      "祝寿",
      "泰华友谊",
      "文友",
      "七律",
      "酬唱"
    ]
  },
  {
    "id": "zy-009",
    "title": "与诸友九溪十八涧踏青",
    "subtitle": "",
    "genre": "七言律诗",
    "tune": "",
    "volume": "卷四·酬唱知交",
    "volumeId": "vol-4",
    "year": "2015",
    "location": "杭州",
    "preface": "乙未暮春，老友数人相约杭州九溪，林木葱茏，溪流溅溅，谈诗论文，极尽欢洽。",
    "content": [
      "春深策杖九溪行，两腋清风石径平。",
      "叠嶂青岚迷去路，数声啼鸟引深晴。",
      "烹茶对语云峰静，拾翠归来宿雨轻。",
      "此日清欢须记取，相逢不必问功名。"
    ],
    "notes": [
      "九溪十八涧：杭州西湖著名风景区，幽深青翠，茶园秀丽。",
      "清欢：苏轼词云“人间有味是清欢”。"
    ],
    "tags": [
      "九溪",
      "踏青",
      "友朋",
      "杭州",
      "七律"
    ]
  },
  {
    "id": "zy-010",
    "title": "水调歌头·中秋望月",
    "subtitle": "",
    "genre": "词曲",
    "tune": "水调歌头",
    "volume": "卷五·倚声填词",
    "volumeId": "vol-5",
    "year": "2017",
    "location": "曼谷湄南河畔",
    "preface": "丁酉中秋，独坐江楼，浩月当空，长空如洗，步东坡韵抒怀。",
    "content": [
      "明月出南浦，碧水接长空。",
      "不知今夕何夕，客路伴清风。",
      "我欲凭轩远望，唯见波平如练，两岸照金宫。",
      "起舞弄花影，何似在其中。",
      "转雕檐，穿幽户，照无眠。",
      "不应有恨，关山千里共婵娟。",
      "人有悲欢聚散，月有阴晴圆缺，此理古难全。",
      "但使文心在，白首笑苍天。"
    ],
    "notes": [
      "南浦：指南方水滨江楼。",
      "金宫：指湄南河沿岸大王宫之夜景金色轮廓。"
    ],
    "tags": [
      "水调歌头",
      "词曲",
      "中秋",
      "明月",
      "抒怀"
    ]
  },
  {
    "id": "zy-011",
    "title": "鹧鸪天·春雨初晴",
    "subtitle": "",
    "genre": "词曲",
    "tune": "鹧鸪天",
    "volume": "卷五·倚声填词",
    "volumeId": "vol-5",
    "year": "2024",
    "location": "书斋",
    "preface": "甲辰暮春，连日阴雨初歇，小院草木葱翠，落红满阶，倚声以记。",
    "content": [
      "细雨初晴燕子飞，小园桃李正芳菲。",
      "风吹绿绮琴声缓，云度青山客梦归。",
      "思往事，惜余晖，浮生聚散几依稀。",
      "凭阑把盏吟新句，不负东君一抹绯。"
    ],
    "notes": [
      "绿绮：古代名琴代称，喻风雅高洁。",
      "东君：古代神话司春之神，代指春光春色。"
    ],
    "tags": [
      "鹧鸪天",
      "词曲",
      "春雨",
      "感春",
      "书斋"
    ]
  },
  {
    "id": "zy-012",
    "title": "芭提雅登高望海",
    "subtitle": "",
    "genre": "七言绝句",
    "tune": "",
    "volume": "卷一·客海萍踪",
    "volumeId": "vol-1",
    "year": "2020",
    "location": "泰国芭提雅",
    "preface": "庚子仲冬客游海滨，极目沧洲，碧浪拍云，信步作绝句一首。",
    "content": [
      "浩荡沧溟接远天，波澄万顷起微烟。",
      "凭高独倚迎风立，不问归舟第几年。"
    ],
    "notes": [
      "1. 沧溟：指广阔之大海。"
    ],
    "tags": [
      "海滨",
      "芭提雅",
      "七绝",
